NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_review?schema=public"
FRONTEND_URL=http://localhost:3000

# Generate a long random value; do not use this example in a deployed application.
ACCESS_TOKEN_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRES_IN=1h

# Used only by pnpm seed. Public signup always creates a STUDENT.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!

# Set only behind a known reverse proxy, e.g. 1 for one proxy hop.
# TRUST_PROXY_HOPS=1

# Separate disposable PostgreSQL database used only by pnpm test:integration.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_review_test"
